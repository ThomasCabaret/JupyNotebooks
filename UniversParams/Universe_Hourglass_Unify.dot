digraph Universe_Hourglass_Refined {
  rankdir=TB;
  compound=true;
  newrank=true;
  nodesep=0.4;
  ranksep=0.6;
  fontname="Segoe UI, Arial";
  splines=curved;

  node [fontname="Segoe UI", shape=box, style="filled,rounded", fillcolor="#FDFEFE", color="#2C3E50", fontsize=10, class="role-node-default role-node-fill role-node-stroke"];
  edge [color="#7F8C8D", fontsize=9, class="role-edge-default role-edge-stroke role-edge-arrowhead"];

  // ==========================================
  // NIVEAUX SUPÉRIEURS (MICRO & MACRO)
  // ==========================================
  { rank=same;
    MICRO_ROOT [label="MICRO-PHYSIQUE", shape=hexagon, fillcolor="#2E86C1", fontcolor=white, fontsize=12, class="step1 role-root-micro role-root role-node-fill role-node-stroke role-text-invert"];
    MACRO_ROOT [label="MACRO-PHYSIQUE", shape=hexagon, fillcolor="#D35400", fontcolor=white, fontsize=12, class="step1 role-root-macro role-root role-node-fill role-node-stroke role-text-invert"];
  }

  MICRO_ROOT -> {GAUGE_S HIGGS_S FLAVOR_S} [color="#AED6F1", class="step2 role-edge-micro role-edge-stroke role-edge-arrowhead"];
  MACRO_ROOT -> {GRAV_S COSMO_S} [color="#FAD7A0", class="step2 role-edge-macro role-edge-stroke role-edge-arrowhead"];

  subgraph cluster_micro_sectors {
    label="Secteurs Micro"; style=dashed; color="#AED6F1"; class="step2 role-cluster-micro role-cluster role-cluster-fill role-cluster-stroke";
    GAUGE_S  [label="Secteur de Jauge\n(Forces)", class="step2 role-sector-micro role-sector role-node-fill role-node-stroke role-text-normal"];
    HIGGS_S  [label="Secteur de Higgs\n(Mécanisme de masse)", class="step2 role-sector-micro role-sector role-node-fill role-node-stroke role-text-normal"];
    FLAVOR_S [label="Secteur de Saveur\n(Matière/particules)", class="step2 role-sector-micro role-sector role-node-fill role-node-stroke role-text-normal"];
  }
  subgraph cluster_macro_sectors {
    label="Secteurs Macro"; style=dashed; color="#FAD7A0"; class="step2 role-cluster-macro role-cluster role-cluster-fill role-cluster-stroke";
    GRAV_S [label="Gravitation", class="step2 role-sector-macro role-sector role-node-fill role-node-stroke role-text-normal"];
    COSMO_S [label="Cosmologie", class="step2 role-sector-macro role-sector role-node-fill role-node-stroke role-text-normal"];
  }

  // ==========================================
  // NIVEAU 3 : VUE NAÏVE
  // ==========================================
  subgraph cluster_naive {
    label="VUE NAÏVE (Variables mathématiques)"; style=filled; fillcolor="#F4F6F6"; color="#BDC3C7"; class="step3 role-cluster-naive role-cluster role-cluster-fill role-cluster-stroke";
    { rank=same;
      N_G    [label="g1, g2, g3, θ_QCD\n(4 paramètres)", fillcolor="#EBEDEF", class="step3 role-naive-gauge role-naive role-node-fill role-node-stroke role-text-normal"];
      N_H    [label="µ², λ\n(2 paramètres)", fillcolor="#EBEDEF", class="step3 role-naive-higgs role-naive role-node-fill role-node-stroke role-text-normal"];

      // Yukawa brutes (indicatif, avant réduction physique)
      N_Q    [label="Matrices Yukawa (Quarks)\nYu, Yd : 36 params bruts", fillcolor="#FADBD8", class="step3 role-naive-quark role-naive role-node-fill role-node-stroke role-text-normal"];
      N_L    [label="Matrices Yukawa (Leptons)\nYe, Yν : 36 params bruts", fillcolor="#FADBD8", class="step3 role-naive-lepton role-naive role-node-fill role-node-stroke role-text-normal"];

      N_GR   [label="G, c\n(2 paramètres)", fillcolor="#FDEBD0", class="step3 role-naive-grav role-naive role-node-fill role-node-stroke role-text-normal"];
      N_LCDM [label="Paramètres ΛCDM\n(6 paramètres)", fillcolor="#FDEBD0", class="step3 role-naive-cosmo role-naive role-node-fill role-node-stroke role-text-normal"];
    }
  }
  GAUGE_S -> N_G [class="step3 role-edge-naive role-edge-stroke role-edge-arrowhead"];
  HIGGS_S -> N_H [class="step3 role-edge-naive role-edge-stroke role-edge-arrowhead"];
  FLAVOR_S -> {N_Q N_L} [class="step3 role-edge-naive role-edge-stroke role-edge-arrowhead"];
  GRAV_S -> N_GR [class="step3 role-edge-naive role-edge-stroke role-edge-arrowhead"];
  COSMO_S -> N_LCDM [class="step3 role-edge-naive role-edge-stroke role-edge-arrowhead"];

  // ==========================================
  // NIVEAU 4 : RÉDUCTION PHYSIQUE (Établi) — VERSION ADIMENSIONNELLE
  // ==========================================
  subgraph cluster_reduced {
    label="RÉDUCTION PHYSIQUE (Paramètres mesurés)";
    style=filled; fillcolor="#D1F2EB"; color="#16A085"; class="step4 role-cluster-reduced role-cluster role-cluster-fill role-cluster-stroke";
    { rank=same;
      // Jauge (4)
      R_G_run  [label="g1, g2, g3\n(Running)\n(3)", fillcolor="#E8DAEF", class="step4 role-reduced-running role-reduced role-node-fill role-node-stroke role-text-normal"];
      R_G_fix  [label="θ_QCD (CP fort)\n(Fixe)\n(1)", fillcolor="#FCF3CF", class="step4 role-reduced-dimensionless role-reduced role-node-fill role-node-stroke role-text-normal"];

      // Higgs (2) — v rendu adimensionnel via une échelle de référence µ0
      R_H_run  [label="λ\n(Running)\n(1)", fillcolor="#E8DAEF", class="step4 role-reduced-running role-reduced role-node-fill role-node-stroke role-text-normal"];
      R_H_dim  [label="v/µ0\n(Échelle VEV adim.)\n(1)", fillcolor="#FCF3CF", class="step4 role-reduced-dimensionless role-reduced role-node-fill role-node-stroke role-text-normal"];

      // Quarks (10)
      R_Q_mass [label="Yukawas quarks → masses relatives\n(6)", fillcolor="#E8DAEF", class="step4 role-reduced-running role-reduced role-node-fill role-node-stroke role-text-normal"];
      R_Q_mix  [label="CKM : 3 angles + 1 phase\n(4)", fillcolor="#FCF3CF", class="step4 role-reduced-dimensionless role-reduced role-node-fill role-node-stroke role-text-normal"];

      // Leptons (10) — masses rendues adimensionnelles (Yukawas + ratios neutrinos)
      R_L_mass [label="Leptons : 3 Yukawas chargés\n+ 3 masses ν (en unités de v)\n(6)", fillcolor="#FCF3CF", class="step4 role-reduced-dimensionless role-reduced role-node-fill role-node-stroke role-text-normal"];
      R_L_mix  [label="PMNS : 3 angles + 1 phase + 2 phases Majorana\n(6)", fillcolor="#FCF3CF", class="step4 role-reduced-dimensionless role-reduced role-node-fill role-node-stroke role-text-normal"];

      // Macro (6)
      R_LCDM6  [label="ΛCDM (6)\nΩ_b h², Ω_c h² (densité baryons / matière noire)\nθ* (échelle angulaire du son), τ (réionisation)\nA_s, n_s (amplitude & pente primordiales)\n(6)", fillcolor="#FCF3CF", class="step4 role-reduced-dimensionless role-reduced role-node-fill role-node-stroke role-text-normal"];
    }
  }

  N_G -> {R_G_run R_G_fix} [class="step4 role-edge-reduced role-edge-stroke role-edge-arrowhead"];
  N_H -> {R_H_run R_H_dim} [class="step4 role-edge-reduced role-edge-stroke role-edge-arrowhead"];
  N_Q -> {R_Q_mass R_Q_mix} [class="step4 role-edge-reduced role-edge-stroke role-edge-arrowhead"];
  N_L -> {R_L_mass R_L_mix} [class="step4 role-edge-reduced role-edge-stroke role-edge-arrowhead"];
  N_GR -> R_LCDM6 [class="step4 role-edge-reduced role-edge-stroke role-edge-arrowhead"];
  N_LCDM -> R_LCDM6 [class="step4 role-edge-reduced role-edge-stroke role-edge-arrowhead"];

  // ==========================================
  // NIVEAU 5 & 6 : UNIFICATION
  // ==========================================
  subgraph cluster_theories {
    label="UNIFICATION THÉORIQUE";
    style=filled; fillcolor="#FEF9E7"; color="#F1C40F"; class="step5 role-cluster-theories role-cluster role-cluster-fill role-cluster-stroke";

    T_SUSY  [label="Supersymétrie (SUSY)\nRelie Jauge & Higgs\nStabilise la Hiérarchie", fillcolor="#F5EEF8", color="#8E44AD", class="step5 role-theory-susy role-theory role-node-fill role-node-stroke role-text-normal"];

    { rank=same;
      T_GUT    [label="Grande Unification (GUT)\n3 Couplages → 1 g_gut\n(ΔDOF = -2)", fillcolor="#D6EAF8", color="#2E86C1", class="step5 role-theory-gut role-theory role-node-fill role-node-stroke role-text-normal"];
      T_PQ     [label="Peccei-Quinn (Axion)\nθ_QCD → Dynamique (axion)\n(ΔDOF ≈ 0)", fillcolor="#D6EAF8", color="#2E86C1", class="step5 role-theory-pq role-theory role-node-fill role-node-stroke role-text-normal"];
      T_FLAVOR [label="Symétries de Saveur\n22 → ~4 paramètres (modèle)\n(ΔDOF = 0 à -18)", fillcolor="#F5EEF8", color="#8E44AD", class="step5 role-theory-flavor role-theory role-node-fill role-node-stroke role-text-normal"];
      T_INF    [label="Inflation Mono-champ\n(A_s, n_s) : 2 → potentiel (≥2)\n(ΔDOF ≈ 0)", fillcolor="#D6EAF8", color="#2E86C1", class="step5 role-theory-inf role-theory role-node-fill role-node-stroke role-text-normal"];
    }
  }

  R_G_run -> T_GUT [style=bold, color="#2E86C1", class="step5 role-edge-theory-gut role-edge-theory role-edge-stroke role-edge-arrowhead"];
  R_G_fix -> T_PQ  [style=bold, color="#2E86C1", class="step5 role-edge-theory-pq role-edge-theory role-edge-stroke role-edge-arrowhead"];
  {R_Q_mass R_Q_mix R_L_mass R_L_mix} -> T_FLAVOR [style=bold, color="#8E44AD", class="step5 role-edge-theory-flavor role-edge-theory role-edge-stroke role-edge-arrowhead"];
  R_LCDM6 -> T_INF [style=bold, color="#2E86C1", class="step5 role-edge-theory-inf role-edge-theory role-edge-stroke role-edge-arrowhead"];

  {R_G_run R_H_run R_H_dim} -> T_SUSY [style=dashed, color="#8E44AD", class="step5 role-edge-theory-susy role-edge-theory role-edge-stroke role-edge-arrowhead"];
  T_SUSY -> T_GUT [style=dotted, color="#8E44AD", label="Support", class="step5 role-edge-theory-support role-edge-theory role-edge-stroke role-edge-arrowhead"];

  TOE [label="CODE SOURCE ULTIME (ToE)\nL'Univers à ~ 5–10 Paramètres", shape=circle, fillcolor="#F1948A", style="filled,bold", fontsize=12, class="step6 role-toe role-root role-node-fill role-node-stroke role-text-normal"];
  {T_GUT T_PQ T_FLAVOR T_SUSY T_INF} -> TOE [color="#E74C3C", class="step6 role-edge-toe role-edge-theory role-edge-stroke role-edge-arrowhead"];
}
